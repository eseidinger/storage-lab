(portal_routes) {
    @couch_all_docs path_regexp ^/couchdb/sl_[0-9a-f]{32}/_all_docs(?:/|$)
    @couch_private path_regexp ^/couchdb/sl_[0-9a-f]{32}/_
    @couch_project path_regexp ^/couchdb/sl_[0-9a-f]{32}(?:/|$)

    route {
        handle @couch_all_docs {
            uri strip_prefix /couchdb
            reverse_proxy couchdb:5984
        }
        handle @couch_private {
            respond 403
        }
        handle @couch_project {
            uri strip_prefix /couchdb
            reverse_proxy couchdb:5984
        }
        handle /couchdb* {
            respond 403
        }
        handle_path /api/* {
            reverse_proxy app:8000 {
                header_up X-Storage-Lab-API true
            }
        }
        handle {
            reverse_proxy app:8000
        }
    }
}

https://{{ storage_lab_portal_host | default('localhost') }}{{ ':443' if (storage_lab_portal_host | default('localhost')) == 'localhost' else '' }} {
{% if (storage_lab_portal_host | default('localhost')) == 'localhost' %}
    tls internal
{% endif %}
    import portal_routes
}

https://caddy {
    tls internal
    import portal_routes
}

https://{{ storage_lab_s3_host | default('localhost') }}:{{ 9443 if (storage_lab_s3_host | default('localhost')) == (storage_lab_portal_host | default('localhost')) else 443 }} {
{% if (storage_lab_s3_host | default('localhost')) == 'localhost' %}
    tls internal
{% endif %}

    @s3_private path_regexp ^/rustfs/(admin|rpc|peer|console)(?:/|$)
    route {
        handle @s3_private {
            respond 403
        }
        handle {
            reverse_proxy rustfs:9000
        }
    }
}

https://{{ storage_lab_clickhouse_host | default('localhost') }}:{{ 9444 if (storage_lab_clickhouse_host | default('localhost')) == (storage_lab_portal_host | default('localhost')) else 443 }} {
{% if (storage_lab_clickhouse_host | default('localhost')) == 'localhost' %}
    tls internal
{% endif %}
    reverse_proxy clickhouse:8123
}

https://{{ storage_lab_qdrant_host | default('localhost') }}:{{ 9445 if (storage_lab_qdrant_host | default('localhost')) == (storage_lab_portal_host | default('localhost')) else 443 }} {
{% if (storage_lab_qdrant_host | default('localhost')) == 'localhost' %}
    tls internal
{% endif %}
    @qdrant_dashboard path /dashboard*
    handle @qdrant_dashboard {
        respond 403
    }
    handle {
        reverse_proxy qdrant:6333
    }
}

https://{{ storage_lab_opensearch_host | default('localhost') }}:9446 {
{% if (storage_lab_opensearch_host | default('localhost')) == 'localhost' %}
    tls internal
{% endif %}
    @security_api path /_plugins/_security/*
    handle @security_api {
        respond 403
    }
    handle {
        reverse_proxy https://opensearch:9200 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }
}

https://{{ storage_lab_opensearch_host | default('localhost') }}:9447 {
{% if (storage_lab_opensearch_host | default('localhost')) == 'localhost' %}
    tls internal
{% endif %}
    reverse_proxy opensearch-dashboards:5601
}

https://{{ storage_lab_hugegraph_host | default('localhost') }}:9448 {
{% if (storage_lab_hugegraph_host | default('localhost')) == 'localhost' %}
    tls internal
{% endif %}
    @project_graph path_regexp ^/graphspaces/DEFAULT/graphs/sl_[0-9a-f]{32}(?:/|$)
    handle @project_graph {
        reverse_proxy hugegraph:8080
    }
    handle {
        respond 403
    }
}
